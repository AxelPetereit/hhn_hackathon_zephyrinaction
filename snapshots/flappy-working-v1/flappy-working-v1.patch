diff --git a/demos/pic64_smp_hello/src/demo_manager.c b/demos/pic64_smp_hello/src/demo_manager.c
index b06cb4f..45b6224 100644
--- a/demos/pic64_smp_hello/src/demo_manager.c
+++ b/demos/pic64_smp_hello/src/demo_manager.c
@@ -244,8 +244,9 @@ static void demo_thread_fn(void *p1, void *p2, void *p3)
 	/* Build persistent overlay first (before any screen) */
 	overlay_create();
 
-	/* Load initial screen */
-	load_screen(0);
+	/* Start directly in Flappy Bird */
+	in_game_mode = true;
+	load_game_screen();
 
 	int64_t next_stat   = k_uptime_get() + 1000;
 	int64_t next_switch = k_uptime_get() + CYCLE_MS;
@@ -267,11 +268,8 @@ static void demo_thread_fn(void *p1, void *p2, void *p3)
 		}
 
 		/* ── Poll game-done flag → return to HUD ───────────────────── */
-		if (in_game_mode && screen_game_is_done()) {
-			in_game_mode = false;
-			load_screen(0);  /* back to HUD */
-			next_switch = now + CYCLE_MS;
-		}
+		/* Game restarts itself in place (screen_game GAME_OVER handles SW2).
+		 * We never leave game mode, so no reload logic is needed here. */
 
 		/* ── 1 Hz: update screen data + refresh overlay ────────────── */
 		if (now >= next_stat) {
