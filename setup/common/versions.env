# Pinned tool versions for the PIC64GX Zephyr hackathon environment.
#
# All three platform setup scripts read this file so that Windows, Linux and
# macOS end up with the same toolchain. Change a version here, not in the
# scripts.
#
# Format is deliberately trivial (KEY=value, no quotes, no expansion) so that
# both POSIX shells and PowerShell can parse it.

# Zephyr revision. Must be >= v4.4.0: the board
# boards/microchip/pic64gx_curiosity_kit was introduced in v4.4.0 and does not
# exist in v4.3.x or earlier. An unpinned "west init" can therefore land on a
# tree that cannot build this project at all.
ZEPHYR_REVISION=v4.4.2

# Zephyr SDK. This is the version requested by Zephyr v4.4.2 (see its
# SDK_VERSION file). Only the riscv64 toolchain is needed for PIC64GX.
ZEPHYR_SDK_VERSION=1.0.1
ZEPHYR_SDK_TOOLCHAIN=riscv64-zephyr-elf

# Build target for the PIC64GX1000 Curiosity Kit, four U54 harts in SMP mode.
BOARD_TARGET=pic64gx_curiosity_kit/pic64gx1000/u54/smp

# SD card payload partition start, LBA 0x22000. The HSS bootloader looks for the
# payload image at this sector.
PAYLOAD_SECTOR=139264

# Upstream HSS payload generator release. Only used on Windows and Linux, where
# official binaries exist. macOS uses setup/common/hss_payload.py instead,
# because the release ships no macOS build and building from source needs
# libelf/gelf.h from elfutils, which is Linux-only.
HSS_VERSION=v2026.04.1

# Python version used for the west virtual environment. Zephyr documents 3.12 as
# well supported; much newer releases occasionally break module dependencies.
PYTHON_PREFERRED=3.12
